{
  "name": "store-api",
  "version": "1.0.0",
  "private": true,
  "description": "E-commerce backend API built with NestJS and Prisma",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "npm --prefix web run build",
    "build:all": "npm run build && npm run build:web",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "lint": "eslint \"{src,test,prisma,scripts}/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:migrate": "ts-node scripts/db-migrate.ts",
    "seed": "ts-node prisma/seed.ts",
    "openapi": "ts-node scripts/write-openapi.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.12",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.2.12",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/testing": "^11.2.12",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
